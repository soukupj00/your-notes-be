# Copy to `.env` and adjust. Every line is optional.

# --- compose.yml and the Caddyfile ---
# The name your devices open. A domain, a Tailscale *.ts.net name, or localhost.
YOUNOTES_HOST=localhost
# auto or internal; see the Caddyfile.
YOUNOTES_TLS=auto
# The server image to run; pin a release, for example v0.1.0.
YOUNOTES_VERSION=latest
# Only for building the image yourself: which frontend image supplies the PWA.
FE_IMAGE=registry.gitlab.fit.cvut.cz/soukuj26/ni-dip-fe:latest

# --- The server (src/config.ts); defaults shown ---
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# PUBLIC_DIR=./public
# PAGE_SIZE=50
# TOMBSTONE_DAYS=90
# SESSION_TTL_DAYS=365
# BODY_LIMIT_BYTES=5242880
# BLOB_LIMIT_BYTES=104857600
# LOG_LEVEL=info
# TRUST_PROXY=false
# The origin Devices open; the first-run Pairing Link points here. compose.yml derives it from YOUNOTES_HOST.
# PUBLIC_URL=http://localhost:3000
