# Copy to `.env` and adjust. Every line is optional.

# --- compose.yml and the Caddyfile ---
# The name your devices open. A domain, a Tailscale *.ts.net name, or localhost.
YOUNOTES_HOST=localhost
# auto or internal; see the Caddyfile.
YOUNOTES_TLS=auto
# The server release to run. Keep it on a numbered release, never `latest`,
# so an update happens only when you change this line (docs/setup.md "Upgrade").
YOUNOTES_VERSION=v0.1.0
# Only for building the image yourself (compose.override.yml): which frontend image supplies the PWA.
FE_IMAGE=gitlab.fit.cvut.cz:5050/soukuj26/ni-dip-fe:latest

# --- The server (src/config.ts); defaults shown ---
# PORT=3000
# HOST=0.0.0.0
# DATA_DIR=./data
# PUBLIC_DIR=./public
# PAGE_SIZE=50
# TOMBSTONE_DAYS=90
# SESSION_TTL_DAYS=365
# BODY_LIMIT_BYTES=5242880
# BLOB_LIMIT_BYTES=104857600
# LOG_LEVEL=info
# TRUST_PROXY=false
# The origin Devices open; the first-run Pairing Link points here. compose.yml derives it from YOUNOTES_HOST.
# PUBLIC_URL=http://localhost:3000

# --- Attachments in an S3 bucket instead of DATA_DIR (docs/setup-backends.md) ---
# disk or s3. With s3, S3_BUCKET is required.
# BLOB_STORE=disk
# The provider's S3 address; leave unset for Amazon S3 itself.
# S3_ENDPOINT=https://s3.example-provider.com
# S3_REGION=us-east-1
# S3_BUCKET=younotes
# The folder in the bucket; the server never touches anything outside it. Empty means the bucket root.
# S3_PREFIX=younotes/
# Both keys or neither; neither means the AWS SDK finds credentials on its own.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# true for the Compose profile `s3` and some providers: the bucket goes in the path, not the host name.
# S3_FORCE_PATH_STYLE=false

# --- The records in PostgreSQL instead of DATA_DIR (docs/setup-backends.md) ---
# Unset means SQLite in DATA_DIR. The password in it is never logged.
# DATABASE_URL=postgres://younotes:choose-a-password@postgres:5432/younotes
# For the Compose profile `postgres`: the database's password, the same as in DATABASE_URL.
# POSTGRES_PASSWORD=choose-a-password
