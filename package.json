{
  "name": "ni-dip-be",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "HOST=127.0.0.1 DATA_DIR=./data tsx watch src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "openapi": "tsx scripts/openapi.ts",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.postgres.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.6",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
